from _typeshed import Incomplete
from collections.abc import Sequence
from typing import Any, final

@final
class WebSocket:
    def accept(self, /) -> Any: ...
    @property
    def client_state(self, /) -> int: ...
    def close(self, /, code: int = 1000) -> Any: ...
    @property
    def headers(self, /) -> Any: ...
    def iter_json(self, /) -> Any: ...
    def iter_text(self, /) -> Any: ...
    @property
    def query_params(self, /) -> Any: ...
    def receive_bytes(self, /) -> Any: ...
    def receive_json(self, /) -> Any: ...
    def receive_text(self, /) -> Any: ...
    @property
    def scope(self, /) -> Any: ...
    def send_bytes(self, /, data: Sequence[int]) -> Any: ...
    def send_json(self, /, data: Any) -> Any: ...
    def send_text(self, /, data: str) -> Any: ...
    @property
    def state(self, /) -> Any: ...

def __getattr__(name: str) -> Incomplete: ...
