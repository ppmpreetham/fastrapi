from collections.abc import Sequence
from typing import Any, final

@final
class OAuth2:
    def __call__(self, /, request: Any) -> str: ...
    def __new__(cls, /, flows: Any |None = None, scheme_name: str |None = None, description: str |None = None, auto_error: bool = True) -> OAuth2: ...
    @property
    def auto_error(self, /) -> bool: ...
    @property
    def description(self, /) -> str |None: ...
    @property
    def flows(self, /) -> Any: ...
    @property
    def scheme_name(self, /) -> str |None: ...

@final
class SecurityScopes:
    def __new__(cls, /, scopes: Sequence[str] |None = None) -> SecurityScopes: ...
    @property
    def scope_str(self, /) -> str: ...
    @property
    def scopes(self, /) -> list[str]: ...
