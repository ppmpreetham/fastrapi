from fastrapi.requests import Request
from fastrapi.security.base import OAuth2 as OAuth3
from typing import Any, final

@final
class OAuth2:
    def __call__(self, /, request: Any) -> str: ...
    def __new__(cls, /, flows: Any |None = None, scheme_name: str |None = None, description: str |None = None, auto_error: bool = True) -> OAuth3: ...
    @property
    def auto_error(self, /) -> bool: ...
    @property
    def description(self, /) -> str |None: ...
    @property
    def flows(self, /) -> Any: ...
    @property
    def scheme_name(self, /) -> str |None: ...

@final
class OAuth2AuthorizationCodeBearer:
    def __call__(self, /, request: Any) -> str: ...
    def __new__(cls, /, authorization_url: str, token_url: str, refresh_url: str |None = None, scopes: dict |None = None, *, scheme_name: str |None = None, description: str |None = None, auto_error: bool = True) -> OAuth2AuthorizationCodeBearer: ...
    @property
    def authorization_url(self, /) -> str: ...
    @property
    def auto_error(self, /) -> bool: ...
    @property
    def description(self, /) -> str |None: ...
    @property
    def refresh_url(self, /) -> str |None: ...
    @property
    def scheme_name(self, /) -> str |None: ...
    @property
    def scopes(self, /) -> dict |None: ...
    @property
    def token_url(self, /) -> str: ...

@final
class OAuth2PasswordBearer:
    def __call__(self, /, request: Any) -> str: ...
    def __new__(cls, /, token_url: str, scheme_name: str |None = None, scopes: dict |None = None, description: str |None = None, auto_error: bool = True) -> OAuth2PasswordBearer: ...
    @property
    def auto_error(self, /) -> bool: ...
    @property
    def description(self, /) -> str |None: ...
    @property
    def scheme_name(self, /) -> str |None: ...
    @property
    def scopes(self, /) -> dict |None: ...
    @property
    def token_url(self, /) -> str: ...

@final
class OAuth2PasswordRequestForm:
    def __call__(self, /, request: Request) -> OAuth2PasswordRequestForm: ...
    def __new__(cls, /, grant_type: str |None = None, username: str |None = None, password: str |None = None, scope: str = ..., client_id: str |None = None, client_secret: str |None = None) -> OAuth2PasswordRequestForm: ...
    @property
    def client_id(self, /) -> str |None: ...
    @property
    def client_secret(self, /) -> str |None: ...
    @property
    def grant_type(self, /) -> str |None: ...
    @property
    def password(self, /) -> str: ...
    @property
    def scope(self, /) -> str: ...
    @property
    def username(self, /) -> str: ...

@final
class OAuth2PasswordRequestFormStrict:
    def __call__(self, /, request: Request) -> OAuth2PasswordRequestFormStrict: ...
    def __new__(cls, /, grant_type: str |None = None, username: str |None = None, password: str |None = None, scope: str = ..., client_id: str |None = None, client_secret: str |None = None) -> OAuth2PasswordRequestFormStrict: ...
    @property
    def client_id(self, /) -> str |None: ...
    @property
    def client_secret(self, /) -> str |None: ...
    @property
    def grant_type(self, /) -> str: ...
    @property
    def password(self, /) -> str: ...
    @property
    def scope(self, /) -> str: ...
    @property
    def username(self, /) -> str: ...
