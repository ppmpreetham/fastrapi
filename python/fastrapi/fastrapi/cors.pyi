from collections.abc import Sequence
from typing import final

@final
class CORSMiddleware:
    def __eq__(self, value: object, /) -> bool: ...
    def __ne__(self, value: object, /) -> bool: ...
    def __new__(self, /, allow_origins: Sequence[str], allow_methods: Sequence[str], allow_headers: Sequence[str], allow_credentials: bool, expose_headers: Sequence[str], max_age: int) -> CORSMiddleware: ...
    @property
    def allow_credentials(self, /) -> bool: ...
    @property
    def allow_headers(self, /) -> list[str]: ...
    @property
    def allow_methods(self, /) -> list[str]: ...
    @property
    def allow_origins(self, /) -> list[str]: ...
    @property
    def expose_headers(self, /) -> list[str]: ...
    @property
    def max_age(self, /) -> int: ...
