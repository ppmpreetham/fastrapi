from typing import Any, final

@final
class HTTPAuthorizationCredentials:
    def __eq__(self, value: object, /) -> bool: ...
    def __ne__(self, value: object, /) -> bool: ...
    @property
    def credentials(self, /) -> str: ...
    @property
    def scheme(self, /) -> str: ...

@final
class HTTPBasic:
    def __call__(self, /, request: Any) -> HTTPBasicCredentials: ...
    def __eq__(self, value: object, /) -> bool: ...
    def __ne__(self, value: object, /) -> bool: ...
    def __new__(cls, /, *, scheme_name: str |None = None, realm: str |None = None, description: str |None = None, auto_error: bool = True) -> HTTPBasic: ...
    @property
    def auto_error(self, /) -> bool: ...
    @property
    def description(self, /) -> str |None: ...
    @property
    def realm(self, /) -> str |None: ...
    @property
    def scheme_name(self, /) -> str |None: ...

@final
class HTTPBasicCredentials:
    def __eq__(self, value: object, /) -> bool: ...
    def __ne__(self, value: object, /) -> bool: ...
    @property
    def password(self, /) -> str: ...
    @property
    def username(self, /) -> str: ...

@final
class HTTPBearer:
    def __call__(self, /, request: Any) -> HTTPAuthorizationCredentials: ...
    def __eq__(self, value: object, /) -> bool: ...
    def __ne__(self, value: object, /) -> bool: ...
    def __new__(cls, /, *, bearer_format: str |None = None, scheme_name: str |None = None, description: str |None = None, auto_error: bool = True) -> HTTPBearer: ...
    @property
    def auto_error(self, /) -> bool: ...
    @property
    def bearer_format(self, /) -> str |None: ...
    @property
    def description(self, /) -> str |None: ...
    @property
    def scheme_name(self, /) -> str |None: ...

@final
class HTTPDigest:
    def __call__(self, /, request: Any) -> str: ...
    def __eq__(self, value: object, /) -> bool: ...
    def __ne__(self, value: object, /) -> bool: ...
    def __new__(cls, /, *, scheme_name: str |None = None, description: str |None = None, auto_error: bool = True) -> HTTPDigest: ...
    @property
    def auto_error(self, /) -> bool: ...
    @property
    def description(self, /) -> str |None: ...
    @property
    def scheme_name(self, /) -> str |None: ...
