from typing import Any, final

@final
class AppInfo:
    def __new__(cls, /, scope: Any) -> AppInfo: ...
    @property
    def state(self, /) -> Any: ...

@final
class ClientInfo:
    def __eq__(self, value: object, /) -> bool: ...
    def __ne__(self, value: object, /) -> bool: ...
    def __new__(self, /, host: str, port: int) -> ClientInfo: ...
    @property
    def host(self, /) -> str: ...
    @property
    def port(self, /) -> int: ...

class HTTPConnection:
    def __bool__(self, /) -> bool: ...
    def __contains__(self, key: Any, /) -> bool: ...
    def __delitem__(self, key: Any, /) -> None: ...
    def __getitem__(self, key: Any, /) -> Any: ...
    def __iter__(self, /) -> Any: ...
    def __len__(self, /) -> int: ...
    def __new__(cls, /, scope: Any, receive: Any |None = None) -> HTTPConnection: ...
    def __repr__(self, /) -> str: ...
    def __setitem__(self, key: Any, value: Any, /) -> None: ...
    @property
    def app(self, /) -> Any: ...
    @property
    def auth(self, /) -> Any: ...
    @property
    def base_url(self, /) -> Any: ...
    @property
    def client(self, /) -> Any: ...
    @property
    def cookies(self, /) -> dict: ...
    def get(self, /, key: Any, default: Any |None = None) -> Any: ...
    @property
    def headers(self, /) -> Any: ...
    def items(self, /) -> Any: ...
    def keys(self, /) -> Any: ...
    @property
    def path_params(self, /) -> Any: ...
    @property
    def query_params(self, /) -> Any: ...
    @property
    def receive(self, /) -> Any: ...
    @receive.setter
    def receive(self, /, value: Any) -> None: ...
    @property
    def scope(self, /) -> Any: ...
    @scope.setter
    def scope(self, /, value: Any) -> None: ...
    @property
    def session(self, /) -> Any: ...
    @property
    def state(self, /) -> Any: ...
    @property
    def url(self, /) -> Any: ...
    def url_for(self, /, name: str, **path_params) -> Any: ...
    @property
    def user(self, /) -> Any: ...
    def values(self, /) -> Any: ...

@final
class Request(HTTPConnection):
    def __new__(cls, /, scope: Any, receive: Any |None = None, send: Any |None = None) -> Request: ...
    def __repr__(self, /) -> str: ...
    def body(self, /) -> Any: ...
    def close(self, /) -> Any: ...
    @property
    def cookies(self, /) -> dict: ...
    def form(self, /) -> Any: ...
    def form_sync(self, /) -> Any: ...
    @property
    def headers(self, /) -> Any: ...
    def is_disconnected(self, /) -> Any: ...
    def json(self, /) -> Any: ...
    @property
    def send(self, /) -> Any: ...
    @send.setter
    def send(self, /, value: Any) -> None: ...
    def send_push_promise(self, /, path: str) -> Any: ...
    def stream(self, /) -> Any: ...
