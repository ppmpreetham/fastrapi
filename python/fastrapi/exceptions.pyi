from typing import Any, final

class DependencyScopeError(FastAPIError):
    def __new__(cls, /) -> DependencyScopeError: ...

@final
class FastAPIDeprecationWarning(UserWarning):
    def __new__(cls, /) -> FastAPIDeprecationWarning: ...

class FastAPIError(RuntimeError):
    def __new__(cls, /) -> FastAPIError: ...

@final
class HTTPException(Exception):
    def __init__(self, /, *_args, **_kwargs) -> None: ...
    def __new__(cls, /, status_code: int, detail: Any |None = None, headers: dict |None = None) -> HTTPException: ...
    def __repr__(self, /) -> str: ...
    def __str__(self, /) -> str: ...
    @property
    def detail(self, /) -> Any: ...
    @property
    def headers(self, /) -> dict |None: ...
    @property
    def status_code(self, /) -> int: ...

class PydanticV1NotSupportedError(FastAPIError):
    def __new__(cls, /) -> PydanticV1NotSupportedError: ...

@final
class RequestValidationError(ValidationException):
    def __init__(self, /, *_args, **_kwargs) -> None: ...
    def __new__(cls, /, errors: Any, *, body: Any |None = None) -> RequestValidationError: ...
    @property
    def body(self, /) -> Any: ...

@final
class ResponseValidationError(ValidationException):
    def __init__(self, /, *_args, **_kwargs) -> None: ...
    def __new__(cls, /, errors: Any, *, body: Any |None = None) -> ResponseValidationError: ...
    @property
    def body(self, /) -> Any: ...

class ValidationException(Exception):
    def __init__(self, /, *_args, **_kwargs) -> None: ...
    def __new__(cls, /, errors: Any) -> ValidationException: ...
    def __str__(self, /) -> str: ...
    @property
    def _errors(self, /) -> Any: ...
    def errors(self, /) -> Any: ...

@final
class WebSocketDisconnect(Exception):
    def __init__(self, /, *_args, **_kwargs) -> None: ...
    def __new__(cls, /, code: int = 1000, reason: str |None = None) -> WebSocketDisconnect: ...
    @property
    def code(self, /) -> int: ...
    @property
    def reason(self, /) -> str |None: ...

@final
class WebSocketException(Exception):
    def __init__(self, /, *_args, **_kwargs) -> None: ...
    def __new__(cls, /, code: int, reason: str |None = None) -> WebSocketException: ...
    def __repr__(self, /) -> str: ...
    def __str__(self, /) -> str: ...
    @property
    def code(self, /) -> int: ...
    @property
    def reason(self, /) -> str |None: ...

@final
class WebSocketRequestValidationError(ValidationException):
    def __init__(self, /, *_args, **_kwargs) -> None: ...
    def __new__(cls, /, errors: Any, *, body: Any |None = None) -> WebSocketRequestValidationError: ...
    @property
    def body(self, /) -> Any: ...
